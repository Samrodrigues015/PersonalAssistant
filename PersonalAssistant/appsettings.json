{
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5-coder:7b"
  },
  "Assistant": {
    "Name": "PersonalAssistant",
    "Language": "pt-PT"
  },
  "Voice": {
    "ModelPath": "Models/ggml-small.bin",
    "GgmlModelType": "Small",
    "Language": "pt",
    "InitialPrompt": "Pedido em português de Portugal a um assistente pessoal. Abre o WhatsApp, manda uma mensagem, lê o documento.",
    "SpeechStartTimeoutSeconds": 6,
    "EndSilenceSeconds": 1.2,
    "MaxRecordingSeconds": 20,
    "SilenceThreshold": 0.015,
    "TtsEngine": "Piper"
  },
  "Piper": {
    "Folder": "Piper",
    "VoiceName": "pt_PT-tugão-medium",
    "LengthScale": 1.0
  },
  "WhatsApp": {
    "UseDesktopApp": true,
    "Contacts": {}
  },
  "Documents": {
    "Folder": "%USERPROFILE%\\Documents\\Assistente",
    "MaxCharacters": 12000
  }
}
